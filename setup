#!/usr/bin/env bash
# Public Bash entry point; Python owns the validated, resumable installer.
set -euo pipefail
samurai_source_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
# shellcheck source=scripts/launcher-common.sh
source "$samurai_source_root/scripts/launcher-common.sh"

case "${1:-}" in
  --help|-h) samurai_setup_help ./setup; exit 0 ;;
  --version)
    sed -n 's/^__version__ = "\([^"]*\)"/\1/p' "$samurai_source_root/samurai_stack/__init__.py"
    exit 0 ;;
esac

samurai_guest_preflight "$samurai_source_root/setup" "$@"
# Keep the caller's working directory for relative --config and recovery.
# Isolated Python cannot import a package planted in that working directory.
exec python3 -I -c 'import sys; sys.path.insert(0, sys.argv.pop(1)); from samurai_stack.setup import main; raise SystemExit(main())' "$samurai_source_root" "$@"
